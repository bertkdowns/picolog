# Optional configuration. A fresh install works without a .env file.
TC08_CHANNELS=1:T,2:T,3:T,4:T,5:T,6:T,7:T,8:T
TC08_INTERVAL=5
TC08_MAINS=50
# TC08_DEVICE_ID=my-tc08
INFLUXDB_DATABASE=picolog
# Rust build parallelism; use 1 to reduce memory pressure on smaller Pis.
INFLUXDB_BUILD_JOBS=2
# Explorer web UI; set the bind address to 0.0.0.0 for access from your LAN.
EXPLORER_BIND_ADDRESS=127.0.0.1
EXPLORER_PORT=8080
# Only for migration from a database that already has an admin token:
# INFLUXDB_TOKEN=your-existing-token
